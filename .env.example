# ─────────────────────────────────────────────────────────────────────────────
# Tabme — copy to .env and fill in a model provider to run the web app.
#
#   cp .env.example .env
#
# Env var names match the CopilotKit Agents Everywhere starter kit so sponsor
# docs and tooling keep working. Do not rename them.
# ─────────────────────────────────────────────────────────────────────────────

# ── MODEL PROVIDER · choose one ──────────────────────
MODEL_PROVIDER=openai
OPENAI_API_KEY=stub-replace-me
MODEL=gpt-5.6-sol

# To use OpenRouter instead:
# MODEL_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# MODEL=openai/gpt-5.6-sol

# Shown in OpenRouter headers; display name only.
APP_TITLE=Tabme
PUBLIC_APP_URL=http://127.0.0.1:3100

LOG_LEVEL=debug
COPILOTKIT_TELEMETRY_DISABLED=true

# ── OPTIONAL TOOLS ───────────────────────────────────
# Exa — grounded web search as an agent tool.
# EXA_API_KEY=
# EXA_SEARCH_TYPE=fast

# Ambiguous AI — the one real workplace write after approval (create a task).
# AMBIGUOUS_API_KEY=

# Tabme review session JSON store (default: .tabme-sessions/ in the web app cwd).
# TABME_SESSION_DIR=/absolute/path/to/tabme-sessions

# CORS: reflect chrome-extension:// and loopback:3100 origins.
# Set CORS_ALLOW_ALL=true to restore wildcard Access-Control-Allow-Origin: *
# CHROME_EXTENSION_ORIGIN=chrome-extension://your-unpacked-extension-id
