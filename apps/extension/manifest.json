{
  "manifest_version": 3,
  "name": "Tabme",
  "version": "0.2.0",
  "description": "Human-in-the-loop tab triage. Review and approve proposed actions right in Chrome's side panel.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabGroups",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3100/*",
    "http://localhost:3100/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabme — One-Click Tab Triage",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
