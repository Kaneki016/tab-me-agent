{
  "manifest_version": 3,
  "name": "Tabme",
  "version": "0.1.0",
  "description": "Capture open tabs for Tabme review. Nothing runs until you approve it.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tabme"
  },
  "permissions": ["tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:3100/*", "http://localhost:3100/*"]
}
