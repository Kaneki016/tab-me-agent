{
  "manifest_version": 3,
  "name": "Tabme",
  "version": "0.2.0",
  "description": "Human-in-the-loop tab triage. Review and approve proposed actions right in Chrome's side panel.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "sidePanel",
    "tabGroups"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:3100/*",
    "http://localhost:3100/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tabme Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
